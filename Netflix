
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>netflix Pro - Movie Streaming</title>

<style>
:root {
  --red: #e50914;
  --bg: #101010;
  --card: #202020;
  --muted: #b3b3b3;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background: var(--bg);
  color: white;
  font-family: Arial, sans-serif;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.navbar {
  position: sticky;
  top: 0;
  z-index: 50;
  min-height: 72px;
  padding: 14px 5%;
  background: #101010f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  border-bottom: 1px solid #252525;
}

.logo {
  color: var(--red);
  font-size: 28px;
  font-weight: 900;
  letter-spacing: 1px;
  text-decoration: none;
}

nav {
  display: flex;
  gap: 20px;
}

nav a {
  color: white;
  text-decoration: none;
  font-size: 14px;
}

nav a:hover {
  color: var(--red);
}

.nav-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}

#searchInput, .login-box input {
  padding: 10px 12px;
  background: #242424;
  color: white;
  border: 1px solid #454545;
  border-radius: 5px;
  outline: none;
}

#searchInput:focus, .login-box input:focus {
  border-color: var(--red);
}

.profile {
  background: var(--red);
  color: white;
  border: 0;
  border-radius: 5px;
  padding: 11px 13px;
  font-weight: bold;
}

.hero {
  min-height: 570px;
  display: flex;
  align-items: center;
  padding: 70px 6%;
  background:
    linear-gradient(90deg, #101010 0%, #101010bb 42%, transparent 100%),
    linear-gradient(0deg, #101010 0%, transparent 55%),
    url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1800&q=85")
    center/cover;
}

.hero-content {
  max-width: 580px;
}

.eyebrow {
  color: #ff4545;
  font-size: 12px;
  letter-spacing: 3px;
  font-weight: bold;
}

.hero h1 {
  font-size: clamp(40px, 6vw, 70px);
  line-height: 1.05;
  margin: 20px 0;
}

.metadata {
  color: #ddd;
  font-size: 14px;
  margin: 15px 0;
}

.description {
  color: #e1e1e1;
  line-height: 1.8;
  margin: 18px 0 24px;
  max-width: 540px;
}

.btn {
  border: 0;
  border-radius: 5px;
  padding: 13px 22px;
  font-weight: bold;
  margin: 0 8px 8px 0;
  transition: .2s;
}

.btn:hover {
  transform: translateY(-2px);
  opacity: .85;
}

.btn-light {
  background: white;
  color: black;
}

.btn-dark {
  background: #454545;
  color: white;
}

.btn-red {
  background: var(--red);
  color: white;
}

.section {
  padding: 30px 5%;
  scroll-margin-top: 85px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.section h2 {
  font-size: 23px;
}

.muted {
  color: var(--muted);
  font-size: 13px;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.filter {
  padding: 10px 18px;
  background: #282828;
  color: white;
  border: 1px solid transparent;
  border-radius: 22px;
}

.filter.active, .filter:hover {
  background: var(--red);
}

.movie-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 18px;
}

.movie-card {
  background: var(--card);
  border-radius: 8px;
  overflow: hidden;
  transition: transform .25s, box-shadow .25s;
}

.movie-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 25px #0009;
}

.poster-wrap {
  height: 245px;
  position: relative;
  overflow: hidden;
  background: #252525;
}

.poster {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .4s;
}

.movie-card:hover .poster {
  transform: scale(1.06);
}

.top-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--red);
  padding: 6px 8px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: bold;
}

.movie-info {
  padding: 13px;
}

.movie-info h3 {
  font-size: 15px;
  margin-bottom: 9px;
}

.movie-meta {
  color: var(--muted);
  font-size: 12px;
  margin-bottom: 13px;
}

.card-actions {
  display: flex;
  gap: 7px;
}

.card-btn {
  flex: 1;
  padding: 9px 5px;
  background: #393939;
  color: white;
  border: 0;
  border-radius: 4px;
  font-size: 12px;
}

.card-btn:hover, .card-btn.saved {
  background: var(--red);
}

.empty {
  color: var(--muted);
  padding: 18px 0;
  line-height: 1.8;
}

footer {
  margin-top: 30px;
  padding: 40px 5%;
  background: #080808;
  text-align: center;
  color: var(--muted);
  line-height: 2;
}

footer h2 {
  color: var(--red);
  letter-spacing: 3px;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: #000d;
  overflow-y: auto;
}

.modal.show {
  display: flex;
}

.modal-box, .login-box {
  position: relative;
  width: 100%;
  max-width: 650px;
  max-height: 92vh;
  overflow-y: auto;
  background: #202020;
  border-radius: 10px;
}

.login-box {
  max-width: 420px;
  padding: 35px;
}

.close {
  position: absolute;
  top: 10px;
  right: 12px;
  z-index: 3;
  width: 38px;
  height: 38px;
  border: 0;
  border-radius: 50%;
  background: #000b;
  color: white;
  font-size: 28px;
}

.modal-body {
  padding: 28px;
}

.modal-body h2, .login-box h2 {
  margin: 15px 0;
  font-size: 28px;
}

.player-area {
  padding: 18px;
  background: #080808;
}

.player-area video {
  width: 100%;
  max-height: 330px;
  background: black;
}

.login-box form {
  display: grid;
  gap: 14px;
  margin: 24px 0;
}

.login-box .btn {
  width: 100%;
}

[hidden] {
  display: none !important;
}

@media (max-width: 1050px) {
  .movie-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 650px) {
  .navbar {
    padding: 12px 4%;
    gap: 12px;
  }

  .logo {
    font-size: 23px;
  }

  nav {
    order: 3;
    width: 100%;
    justify-content: space-between;
    gap: 10px;
  }

  nav a {
    font-size: 12px;
  }

  #searchInput {
    width: 140px;
  }

  .hero {
    min-height: 500px;
    padding: 60px 5%;
    background-position: center;
  }

  .hero h1 {
    font-size: 42px;
  }

  .section {
    padding: 24px 4%;
  }

  .section h2 {
    font-size: 19px;
  }

  .movie-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .poster-wrap {
    height: 210px;
  }

  .login-box {
    padding: 25px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
</style>
</head>

<body>

<header class="navbar">
  <a href="#home" class="logo"><b><i>Netflix</i></b></a>

  <nav>
    <a href="#home">Home</a>
    <a href="#movies">Movies</a>
    <a href="#series">Series</a>
    <a href="#mylist">My List</a>
  </nav>

  <div class="nav-actions">
    <input id="searchInput" type="search"
           placeholder="Search..." aria-label="Search titles">
    <button class="profile" id="loginBtn">RR</button>
  </div>
</header>

<main>
  <section class="hero" id="home">
    <div class="hero-content">
      <span class="eyebrow">N ORIGINAL • FEATURED</span>
      <h1>THE LAST SIGNAL</h1>
      <p class="metadata">2026 | Sci-Fi | 16+ | 2h 08m</p>

      <p class="description">
        A mysterious signal from deep space changes everything.
        One explorer must uncover the truth before time runs out.
      </p>

      <button class="btn btn-light" id="heroPlay">▶ Play</button>
      <button class="btn btn-dark" id="heroInfo">ⓘ More Info</button>
    </div>
  </section>

  <section class="section" id="movies">
    <div class="section-heading">
      <h2 id="catalogTitle">Trending Now</h2>
      <span class="muted">Discover something new</span>
    </div>

    <div class="filters" id="filters">
      <button class="filter active" data-category="All">All</button>
      <button class="filter" data-category="Movie">Movies</button>
      <button class="filter" data-category="Series">Series</button>
      <button class="filter" data-category="Sci-Fi">Sci-Fi</button>
      <button class="filter" data-category="Action">Action</button>
    </div>

    <div class="movie-grid" id="movieGrid"></div>
    <p id="emptyMessage" class="empty" hidden>
      No titles found. Try another search.
    </p>
  </section>

  <section class="section" id="series">
    <div class="section-heading">
      <h2>Popular Series & Movies</h2>
    </div>
    <p class="muted">Browse all titles using the filters above.</p>
  </section>

  <section class="section" id="mylist">
    <div class="section-heading">
      <h2>My List</h2>
      <span class="muted">Your saved titles</span>
    </div>
    <div class="movie-grid" id="watchGrid"></div>
    <p id="watchEmpty" class="empty">
      Your list is empty. Add a movie to get started.
    </p>
  </section>
</main>
<div class="modal" id="movieModal" aria-hidden="true">
  <div class="modal-box" role="dialog"
       aria-modal="true" aria-labelledby="modalTitle">

    <button class="close" id="closeModal" aria-label="Close">×</button>

    <div class="player-area" id="playerArea" hidden>
      <video id="videoPlayer" controls playsinline></video>
      <p id="playerNotice" class="muted">
        Connect your own authorized video file to play.
      </p>
    </div>

    <div class="modal-body">
      <span class="eyebrow">NETFLIX PRO</span>
      <h2 id="modalTitle">Movie Title</h2>
      <p id="modalMeta" class="metadata"></p>
      <p id="modalDescription" class="description"></p>

      <button class="btn btn-light" id="modalPlay">▶ Play</button>
      <button class="btn btn-dark" id="modalSave">+ My List</button>
    </div>
  </div>
</div>

<!-- Demo Login Modal -->
<div class="modal" id="loginModal" aria-hidden="true">
  <div class="login-box" role="dialog"
       aria-modal="true" aria-labelledby="loginTitle">

    <button class="close" id="closeLogin" aria-label="Close">×</button>

    <h2 id="loginTitle">Welcome Back</h2>
    <p class="muted">Demo sign-in form</p>

    <form id="loginForm">
      <input id="emailInput" type="email"
             placeholder="Email address" required>
      <input id="passwordInput" type="password"
             placeholder="Password" minlength="6" required>
      <button class="btn btn-red" type="submit">Sign In</button>
    </form>

    <p id="loginMessage" class="muted" aria-live="polite"></p>
  </div>
</div>

<script>
const movies = [
  {
    id: 1,
    title: "Inception",
    type: "Movie",
    genre: "Sci-Fi",
    year: 2010,
    rating: "8.8",
    poster: "photo-1440404653325-ab127d49abc1",
    description: "A skilled dream thief enters a world where dreams and reality collide."
  },
  {
    id: 2,
    title: "Interstellar",
    type: "Movie",
    genre: "Sci-Fi",
    year: 2014,
    rating: "8.7",
    poster: "photo-1446776811953-b23d57bd21aa",
    description: "A team travels through space in search of a future for humanity."
  },
  {
    id: 3,
    title: "Dark",
    type: "Series",
    genre: "Sci-Fi",
    year: 2020,
    rating: "8.5",
    poster: "photo-1518709268805-4e9042af9f23",
    description: "A mysterious disappearance connects families across generations."
  },
  {
    id: 4,
    title: "The Adventure",
    type: "Movie",
    genre: "Action",
    year: 2024,
    rating: "7.9",
    poster: "photo-1517604931442-7e0c8ed2963c",
    description: "Explorers face unexpected challenges on a dangerous journey."
  },
  {
    id: 5,
    title: "Wild Planet",
    type: "Series",
    genre: "Action",
    year: 2025,
    rating: "8.1",
    poster: "photo-1472396961693-142e6e269027",
    description: "Adventurers discover secrets hidden deep in the wilderness."
  },
  {
    id: 6,
    title: "The Mystery",
    type: "Movie",
    genre: "Action",
    year: 2023,
    rating: "7.8",
    poster: "photo-1500534623283-312aade485b7",
    description: "A detective follows clues to solve an unusual mystery."
  },
  {
    id: 7,
    title: "Lost Galaxy",
    type: "Movie",
    genre: "Sci-Fi",
    year: 2025,
    rating: "8.4",
    poster: "photo-1462331940025-496dfbfc7564",
    description: "A stranded crew searches for a way home among distant worlds."
  },
  {
    id: 8,
    title: "Shadow City",
    type: "Series",
    genre: "Action",
    year: 2024,
    rating: "8.0",
    poster: "photo-1519608487953-e999c86e7455",
    description: "A detective uncovers a secret beneath a modern city."
  },
  {
    id: 9,
    title: "Beyond Earth",
    type: "Movie",
    genre: "Sci-Fi",
    year: 2026,
    rating: "8.2",
    poster: "photo-1451187580459-43490279c0fa",
    description: "A new mission takes humanity further into the unknown."
  },
  {
    id: 10,
    title: "Final Mission",
    type: "Series",
    genre: "Action",
    year: 2025,
    rating: "7.9",
    poster: "photo-1480714378408-67cf0d13bc1b",
    description: "A team races against time to complete its hardest mission."
  }
];

const grid = document.getElementById("movieGrid");
const watchGrid = document.getElementById("watchGrid");
const searchInput = document.getElementById("searchInput");
const movieModal = document.getElementById("movieModal");
const loginModal = document.getElementById("loginModal");
const videoPlayer = document.getElementById("videoPlayer");

// Add your own authorized MP4 video URL here if needed.
const DEMO_VIDEO_URL = "";

let category = "All";
let searchText = "";
let currentMovie = null;
let watchlist = new Set();

try {
  const saved = JSON.parse(
    localStorage.getItem("netflixProWatchlist") || "[]"
  );

  if (Array.isArray(saved)) {
    saved.forEach(id => {
      if (movies.some(movie => movie.id === id)) {
        watchlist.add(id);
      }
    });
  }
} catch (error) {
  console.warn("Saved list could not be loaded.");
}

function imageURL(poster) {
  return `https://images.unsplash.com/${poster}?auto=format&fit=crop&w=500&q=80`;
}

function saveList() {
  try {
    localStorage.setItem(
      "netflixProWatchlist",
      JSON.stringify([...watchlist])
    );
  } catch (error) {
    console.warn("Browser storage unavailable.");
  }
}

function makeCard(movie) {
  const card = document.createElement("article");
  card.className = "movie-card";

  const wrap = document.createElement("div");
  wrap.className = "poster-wrap";

  const img = document.createElement("img");
  img.className = "poster";
  img.src = imageURL(movie.poster);
  img.alt = movie.title + " poster";
  img.loading = "lazy";

  const badge = document.createElement("span");
  badge.className = "top-badge";
  badge.textContent = "N ORIGINAL";

  wrap.append(img, badge);

  const info = document.createElement("div");
  info.className = "movie-info";

  const title = document.createElement("h3");
  title.textContent = movie.title;

  const meta = document.createElement("p");
  meta.className = "movie-meta";
  meta.textContent =
    `${movie.year} • ${movie.type} • ★ ${movie.rating}`;

  const actions = document.createElement("div");
  actions.className = "card-actions";

  const details = document.createElement("button");
  details.className = "card-btn";
  details.textContent = "ⓘ Details";
  details.addEventListener("click", () => openDetails(movie));

  const save = document.createElement("button");
  save.className = "card-btn";
  save.classList.toggle("saved", watchlist.has(movie.id));
  save.textContent = watchlist.has(movie.id) ? "✓ Saved" : "+ My List";
  save.setAttribute("aria-pressed", String(watchlist.has(movie.id)));
  save.addEventListener("click", () => toggleSaved(movie.id));

  actions.append(details, save);
  info.append(title, meta, actions);
  card.append(wrap, info);

  return card;
}

function renderWatchlist() {
  watchGrid.replaceChildren();

  const savedMovies = movies.filter(movie => watchlist.has(movie.id));

  savedMovies.forEach(movie => watchGrid.appendChild(makeCard(movie)));

  document.getElementById("watchEmpty").hidden =
    savedMovies.length > 0;
}

function renderMovies() {
  grid.replaceChildren();

  const results = movies.filter(movie => {
    const matchesCategory =
      category === "All" ||
      movie.type === category ||
      movie.genre === category;

    const searchable =
      `${movie.title} ${movie.genre} ${movie.year}`.toLowerCase();

    return matchesCategory &&
      searchable.includes(searchText.toLowerCase());
  });

  results.forEach(movie => grid.appendChild(makeCard(movie)));

  document.getElementById("emptyMessage").hidden =
    results.length > 0;

  renderWatchlist();
}

function toggleSaved(id) {
  if (watchlist.has(id)) {
    watchlist.delete(id);
  } else {
    watchlist.add(id);
  }

  saveList();
  renderMovies();

  if (currentMovie && currentMovie.id === id) {
    updateSaveButton();
  }
}

function updateSaveButton() {
  if (!currentMovie) return;

  document.getElementById("modalSave").textContent =
    watchlist.has(currentMovie.id)
      ? "✓ Remove from My List"
      : "+ My List";
}

function showModal(modal) {
  modal.classList.add("show");
  modal.setAttribute("aria-hidden", "false");
  document.body.style.overflow = "hidden";
}

function hideModal(modal) {
  modal.classList.remove("show");
  modal.setAttribute("aria-hidden", "true");

  if (!movieModal.classList.contains("show") &&
      !loginModal.classList.contains("show")) {
    document.body.style.overflow = "";
  }
}

function openDetails(movie) {
  currentMovie = movie;

  document.getElementById("modalTitle").textContent = movie.title;
  document.getElementById("modalMeta").textContent =
    `${movie.year} • ${movie.type} • ${movie.genre} • ★ ${movie.rating}`;

  document.getElementById("modalDescription").textContent =
    movie.description;

  document.getElementById("playerArea").hidden = true;

  videoPlayer.pause();
  videoPlayer.removeAttribute("src");
  videoPlayer.load();

  document.getElementById("playerNotice").textContent =
    "Connect an authorized video source to enable playback.";

  updateSaveButton();
  showModal(movieModal);
}

function playCurrentMovie() {
  if (!currentMovie) return;

  document.getElementById("playerArea").hidden = false;

  if (!DEMO_VIDEO_URL) {
    document.getElementById("playerNotice").textContent =
      "Demo player: add your authorized MP4 URL to DEMO_VIDEO_URL in the code.";
    return;
  }

  videoPlayer.src = DEMO_VIDEO_URL;

  videoPlayer.play().catch(() => {
    document.getElementById("playerNotice").textContent =
      "Press Play in the video controls to start playback.";
  });
}

document.getElementById("filters").addEventListener("click", event => {
  const button = event.target.closest("[data-category]");
  if (!button) return;

  category = button.dataset.category;

  document.querySelectorAll(".filter").forEach(item => {
    item.classList.toggle("active", item === button);
  });

  document.getElementById("catalogTitle").textContent =
    category === "All" ? "Trending Now" : category + " Titles";

  renderMovies();
});

searchInput.addEventListener("input", () => {
  searchText = searchInput.value.trim();
  renderMovies();
});

function openFeatured() {
  openDetails({
    id: 100,
    title: "The Last Signal",
    type: "Featured",
    genre: "Sci-Fi",
    year: 2026,
    rating: "8.6",
    description:
      "A mysterious signal from deep space changes the future of humanity."
  });
}

document.getElementById("heroPlay").addEventListener("click", () => {
  openFeatured();
  playCurrentMovie();
});

document.getElementById("heroInfo").addEventListener("click", openFeatured);

document.getElementById("modalPlay").addEventListener(
  "click", playCurrentMovie
);

document.getElementById("modalSave").addEventListener("click", () => {
  if (currentMovie && currentMovie.id !== 100) {
    toggleSaved(currentMovie.id);
  } else {
    alert("This featured title is a demo and cannot be saved.");
  }
});

document.getElementById("closeModal").addEventListener("click", () => {
  videoPlayer.pause();
  hideModal(movieModal);
});

movieModal.addEventListener("click", event => {
  if (event.target === movieModal) {
    videoPlayer.pause();
    hideModal(movieModal);
  }
});

document.getElementById("loginBtn").addEventListener("click", () => {
  showModal(loginModal);
});

document.getElementById("closeLogin").addEventListener("click", () => {
  hideModal(loginModal);
});

loginModal.addEventListener("click", event => {
  if (event.target === loginModal) hideModal(loginModal);
});

document.getElementById("loginForm").addEventListener("submit", event => {
  event.preventDefault();

  document.getElementById("loginMessage").textContent =
    "Demo only. No account was created and no credentials were sent.";

  document.getElementById("passwordInput").value = "";
});

document.addEventListener("keydown", event => {
  if (event.key === "Escape") {
    videoPlayer.pause();
    hideModal(movieModal);
    hideModal(loginModal);
  }
});

renderMovies();
</script>

</body>
</html>
